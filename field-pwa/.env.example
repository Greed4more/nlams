# NLAMS Express API (server/) — same backend the main NLAMS web app talks to.
# The field PWA authenticates against it via the demo bypass endpoint
# (POST /api/public/auth/bypass) and syncs field data against its real
# /api/proposals, /api/parcels/verify and /api/grievances routes.
VITE_API_BASE_URL="http://localhost:4000"
