# Postgres — matches docker-compose.yml at the repo root
DATABASE_URL="postgresql://nlams:nlams_dev_password@localhost:5432/nlams?schema=public"

# Demo sign-in bypass (server/src/lib/bypassAuth.ts) — lets anyone who clones
# this repo sign in WITHOUT a Supabase account, using this shared password on
# the sign-in page's "Quick Demo Access" panel. Only needs the local Postgres
# above (docker-compose, no account required). Defaults to "nlams-demo-2026"
# if unset — change it (or unset SUPABASE_* below and rely on this instead)
# for anything beyond a local demo.
BYPASS_PASSWORD="nlams-demo-2026"

# Supabase (used ONLY for auth here — app data stays in the Postgres above).
# supabase.com → your project → Settings → API.
SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"
# Service-role key — server-only, never expose to the browser. Needed to
# verify session tokens and to set app_metadata.role on demo users.
SUPABASE_SERVICE_ROLE_KEY="eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

PORT=4000
# Comma-separated. 8080 matches vite.config.ts's dev server port for the main
# web app; 5173 is the field-pwa's Vite default dev port.
CORS_ORIGIN="http://localhost:8080,http://localhost:5173"

# Litigation & delay risk microservice (Module 5, ported from BHUMITRA/ml_service).
# `docker compose up -d ml_service` or `cd ml_service && uvicorn main:app --port 8000`.
# If unreachable, server/src/services/riskBridge.ts falls back to a local estimate.
ML_SERVICE_URL="http://localhost:8000"

# ISRO Bhuvan WMS endpoint for the multi-crop-irrigated LULC overlay check
# used by POST /api/parcels/verify. Falls back to a cached bounding-box
# heuristic for the West Bengal pilot districts if unreachable.
BHUVAN_WMS_URL="https://bhuvan-vec1.nrsc.gov.in/bhuvan/wms"

# SLA breach/at-risk email alerts (server/src/lib/notify.ts). Optional — if
# either is unset, alerts are still logged to the console by the scanner,
# just not emailed. Get a key at https://resend.com (free tier is enough for
# a demo); ALERT_EMAIL_TO can be a comma-separated list.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
ALERT_EMAIL_FROM="NLAMS Alerts <alerts@yourdomain.com>"
ALERT_EMAIL_TO="dolr.secretary@example.gov.in"
