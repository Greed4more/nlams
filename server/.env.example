# Postgres — matches docker-compose.yml at the repo root
DATABASE_URL="postgresql://nlams:nlams_dev_password@localhost:5432/nlams?schema=public"

# Supabase (used ONLY for auth here — app data stays in the Postgres above).
# supabase.com → your project → Settings → API.
SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"
# Service-role key — server-only, never expose to the browser. Needed to
# verify session tokens and to set app_metadata.role on demo users.
SUPABASE_SERVICE_ROLE_KEY="eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

PORT=4000
# Matches vite.config.ts's dev server port (8080), not the Vite default (5173/3000).
CORS_ORIGIN="http://localhost:8080"

# Litigation & delay risk microservice (Module 5, ported from BHUMITRA/ml_service).
# `docker compose up -d ml_service` or `cd ml_service && uvicorn main:app --port 8000`.
# If unreachable, server/src/services/riskBridge.ts falls back to a local estimate.
ML_SERVICE_URL="http://localhost:8000"

# ISRO Bhuvan WMS endpoint for the multi-crop-irrigated LULC overlay check
# used by POST /api/parcels/verify. Falls back to a cached bounding-box
# heuristic for the West Bengal pilot districts if unreachable.
BHUVAN_WMS_URL="https://bhuvan-vec1.nrsc.gov.in/bhuvan/wms"
